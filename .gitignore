# ~/.config is symlinked here and apps write runtime state and credentials
# into it. Ignore everything and opt tracked tools back in.
config/*
!config/bat/
!config/bd/
!config/fish/
!config/gh/
!config/ghostty/
!config/herdr/
!config/karabiner/
!config/mise/
!config/nvim/
!config/rex/
!config/skl/
!config/starship.toml
!config/stylua/
!config/tmux/
!config/zed/

# Runtime state inside tracked tools
config/fish/fish_variables
config/fish/fisher
config/fish/functions/*
config/fish/completions/*
config/fish/conf.d/fzf.fish
!config/fish/functions/_warn_no_command.fish
!config/fish/functions/e.fish
!config/fish/functions/gpc.fish
!config/fish/functions/mkc.fish
config/gh/hosts.yml
config/herdr/release-notes.json
config/herdr/session.json
config/nvim/.netrwhist
config/nvim/backups
config/nvim/pack
config/nvim/plugin
config/nvim/.luarc.json
config/tmux/plugins/
config/zed/embeddings
config/zed/prompts
config/zed/conversations

zsh/plugins.lock
zsh/repositories
aws/credentials

# Pi runtime/private data. Track only explicit config files under pi/agent/.
pi/agent/auth.json
pi/agent/trust.json
pi/agent/sessions/
pi/agent/npm/
pi/agent/**/*.jsonl

# Local agent instructions
CLAUDE.local.md
AGENTS.local.md
.claude/settings.local.json

node_modules
.netrwhist
*.log
*.bak
