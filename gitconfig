[user]
  name = Fernando Paredes
  email = nano@fdp.io
  signingkey = /Users/nano/.ssh/id_ed25519.pub

[push]
  default = current
  autoSetupRemote = true
  followTags = true

[branch]
  sort = -committerdate
  autoSetupMerge = simple

[color "diff"]
  commit = green
  meta = yellow
  frag = cyan
  old = red
  new = green
  whitespace = red reverse
  newMoved = cyan
  oldMoved = blue

[color "status"]
  untracked = cyan

[alias]
  a = add
  aa = add --all
  ai = add --interactive
  amend = commit --amend
  ap = add --patch

  biggest = "!git rev-list --objects --all | grep `git verify-pack -v .git/objects/pack/*.idx | sort -k 3 -n | tail -1 | awk '{ print $1 }'`"
  branches = branch -a

  ca = commit --amend
  ci = commit --verbose
  cl = clone --recursive
  co = checkout

  # Determines the branch we're on
  current = rev-parse --abbrev-ref HEAD

  dc = diff --cached

  # Default branch of origin (kept current by fetch.followRemoteHEAD), falling back to main
  default-branch = "!b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD) && echo \"${b#origin/}\" || echo main"

  # `git di $number` shows the diff between the state `$number` revisions ago and the current state
  di = !"d() { git diff --patch-with-stat HEAD~$1; }; git diff-index --quiet HEAD -- || clear; d"

  # Displays a diff from the start of history
  diff-from-start = "!git diff --color=always --stat $(git hash-object -t tree /dev/null)"

  f = files

  # Add fallback logic
  fallback-to-base = "!if [ -n \"$1\" ]; then echo \"$1\"; else git default-branch; fi #"

  filelog = log -u
  files = "!git ls-files | grep -i"

  # Append patterns to the repo's .gitignore, skipping ones already there
  ignore = "!f() { for p; do grep -qxF -- \"$p\" .gitignore 2>/dev/null || echo \"$p\" >> .gitignore; done; }; f"

  # Remove tracked files
  forget = rm -r --cached

  # Find tags containing commit
  ft = "!f() { git describe --always --contains $1; }; f"

  fza = "!git ls-files -m -o --exclude-standard | fzf --print0 -m | xargs -0 -t -o git add"

  # Interactive branch switching with preview
  fbr = "!git branch --sort=-committerdate | fzf --preview 'git log --oneline --graph --date=short --color=always --pretty=\"format:%C(auto)%cd %h%d %s\" $(sed s/^..// <<< {} | cut -d\" \" -f1)' | sed 's/^..//' | cut -d' ' -f1 | xargs git checkout"

  # Interactive stash browser
  fstash = "!git stash list | fzf --preview 'echo {} | cut -d: -f1 | xargs git stash show -p --color=always' --preview-window=right:60% | cut -d: -f1"

  graph = log --graph --pretty=format:'%C(auto)%h%d %s %C(black)%C(bold)%cr %C(blue)%an' --all
  laf = fsck --lost-found
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  ls-ignored = ls-files --exclude-standard --ignored --others
  m = "!git switch \"$(git default-branch)\""
  merge-branch = "!git switch \"$(git default-branch)\" && git merge @{-1} --ff-only"
  pf = push --force-with-lease
  recent = for-each-ref --sort=-committerdate --format='%(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(objectname:short)%(color:reset) - %(contents:subject) - %(color:blue)%(authorname)%(color:reset) (%(color:green)%(committerdate:relative)%(color:reset))' refs/heads/ --count=10

  # Display a diff of changes since branch-off point
  review = "!git diff $(git review-base \"$1\") #"

  # Determines the branch that started the current branch
  review-base = "!git merge-base `git current` $(git fallback-to-base \"$1\") #"

  rebase-origin = "!git fetch origin && git rebase origin/HEAD"
  releases = log --decorate --oneline --simplify-by-decoration --all
  reset-hard = reset --hard HEAD
  stats = shortlog -sn --all --no-merges
  sw = switch
  st = status --short --branch
  tagage = for-each-ref --sort=taggerdate --format=%(refname:short) refs/tags
  unpushed = log --oneline @{u}..HEAD

  # Worktree management
  wt = worktree list
  wta = worktree add
  wtr = worktree remove
  wtp = worktree prune

[core]
  attributesfile = ~/.gitattributes
  excludesfile = ~/.gitignore
  editor = nvim
  pager = delta
  # fsmonitor = true  # Disabled - causes issues on macOS
  # splitIndex = true  # Disabled - can cause index issues

[credential]
  helper = osxkeychain

[rebase]
  autostash = true
  autosquash = true
  updateRefs = true
  missingCommitsCheck = warn
  stat = true

[stash]
  showPatch = true

[submodule]
  fetchJobs = 0

[diff]
  colorMoved = default
  colorMovedWS = allow-indentation-change
  algorithm = histogram
  mnemonicPrefix = true
  wsErrorHighlight = all
  context = 5
  # Detect copies and renames
  renames = copies

[interactive]
  diffFilter = delta --color-only

[pull]
  rebase = true

[include]
  path = ~/.gitconfig.local

[rerere]
  enabled = true
  autoupdate = true

[apply]
  whitespace = nowarn

[commit]
  verbose = true
  gpgsign = true

[diff "plist"]
  textconv = plutil -convert xml1 -o -

[diff "provision"]
  textconv = openssl smime -inform der -verify -in

[diff "bin"]
  # Use `hexdump` to diff binary files
  textconv = hexdump -v -C

[diff "lockb"]
  textconv = bun
  binary = true

[filter "lfs"]
  smudge = git-lfs smudge -- %f
  required = true
  clean = git-lfs clean -- %f

[feature]
  # manyFiles = true  # Only enable if needed for large repos
  # experimental = true  # Disabled - causes index corruption

[maintenance]
  auto = true
  strategy = incremental

[transfer]
  # Also covers fetch.fsckObjects and receive.fsckObjects
  fsckObjects = true

[advice]
  detachedHead = false
  statusHints = false
  pushNonFastForward = false

[log]
  date = iso

[fetch]
  prune = true
  prunetags = true
  writeCommitGraph = true
  # Keep origin/HEAD pointing at the remote's default branch (git 2.56+)
  followRemoteHEAD = always

[init]
  defaultBranch = main

[commitGraph]
  changedPaths = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[delta]
  side-by-side = true
  features = decorations

[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow ul
  file-decoration-style = none
  hunk-header-decoration-style = yellow box

[checkout]
  workers = 0

[merge]
  conflictstyle = zdiff3
  autoStash = true
