#!/usr/bin/env sh
#/ Usage: git-large-files [count]
#/ List the largest blobs anywhere in history with their paths (default: 10).

set -eu

case "${1:-}" in
  -h|--help) grep '^#/' "$0" | cut -c4-; exit 0 ;;
esac

count="${1:-10}"

git rev-list --objects --all |
  git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' |
  awk '$1 == "blob"' |
  sort -k3 -n -r |
  head -n "$count" |
  awk '{
    size = $3; unit = "B"
    if (size >= 1048576) { size /= 1048576; unit = "MiB" }
    else if (size >= 1024) { size /= 1024; unit = "KiB" }
    path = $0; sub(/^[^ ]+ [^ ]+ [^ ]+ ?/, "", path)
    printf "%s  %8.1f %-3s  %s\n", substr($2, 1, 12), size, unit, path
  }'
